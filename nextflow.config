        }

        withName: 'unicycler' {
          cpus = '16'
          memory = '15G'
          //clusterOptions = '--time=15:00:00'
          time = { 3.hour * task.attempt }
          errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        }

        withName: 'unicyclerSE' {
          cpus = '16'
          memory = '15G'
          //clusterOptions = '--time=15:00:00'
          time = { 3.hour * task.attempt }
          errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        }

        withName: 'bwaIndex' {
          cpus = 4
          memory = '2G'

        }

        withName: 'samtools' {
          cpus = 4
          memory = '8G'
          time = { 10.minute * task.attempt }
        }

        withName: 'pilon_remapping' {
          cpus = 4
          memory = '20G'
          time = { 10.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'pilon_remappingSE' {
          cpus = 4
          memory = '20G'
          time = { 10.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'prokka' {
          cpus = 10
          memory = '8G'
          time = { 1.hour * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'rMLST' {
          cpus = 4
          memory = '4G'
          time = { 15.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'metaphlan4' {
          cpus = '16'
          memory = '30G'
          time = { 45.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'metaphlan4SE' {
          cpus = '16'
          memory = '30G'
          time = { 15.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'abricate' {
          cpus = 2
          memory = '2G'
          time = { 10.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'busco' {
          cpus = '16'
          memory = '15G'
          time = { 1.hour * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'gtdbtk_classify_wf' {
          cpus = '16'
          memory = '80G'
          time = {'1.hour' * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'alignRemapping' {
          cpus = '8'
          memory = {task.attempt==1 ? '5G' : '8G'}
          time = { 15.m * task.attempt }
        }

        withName: 'alignRemappingSE' {
          cpus = '8'
          memory = {task.attempt==1 ? '5G' : '8G'}
          time = { 15.m * task.attempt }
        }

        withName: 'link_reads' {
          container = null
          cpus = '1'
          memory = '1G'
        }

        withName: 'links_for_transfer' {
          container = null
          cpus = '1'
          memory = '1G'
        }

        withName: 'summary_sample' {
          container = null
          cpus = '1'
          memory = '1G'
        }

        withName: 'merge_summaries' {
          container = null
          cpus = '1'
          memory = '1G'
        }
     }
   }


}
