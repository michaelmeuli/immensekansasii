includeConfig "$baseDir/params.config"

process.shell = ['/bin/bash','-e']

process.container = 'quay.io/biocontainers/unicycler:0.5.0--py38h5cf8b27_3'

singularity {
  cacheDir = "/shares/amr.imm.uzh/.singularity_IMMENSE"
  autoMounts = 'true'
  singularity.enabled = true
  runOptions = '-B /scratch -B /home -B /shares -B /data -B /tmp' 
}

manifest {
  name = "IMMENSE on S3IT"
  version = '0.5.2'
}

profiles {

   slurm {
     executor {
        name="slurm"
        queueSize = 100
        clusterOptions = '--time=48:00:00'
        submitRateLimit = '5 sec'
        exitReadTimeout = '30 min'
     }

     process {
        containerOptions = { workflow.containerEngine == "docker" ? '-u $(id -u):$(id -g)': null}
        time = '5 min'
        cpus = '4'
        memory = '4G'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        cache = 'lenient'
        
        withName: 'bcl2fastq' {
          memory = '50G'
          clusterOptions = '--time=06:00:00'
          time = { 30.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'fastqc' {
          cpus = '1'
          memory = '3G'
        }

        withName: 'multiqc' {
          cpus = '1'
          memory = '500M'
        }

        withName: 'trimmomaticPE' {
          memory = '10G'
          time = { 8.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'trimmomaticSE' {
          memory = '10G'
          time = { 8.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'unicycler' {
          cpus = '16'
          memory = '30G'
          clusterOptions = '--time=16:00:00'
          time = { 2.hour * task.attempt*task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 2
        }

        withName: 'unicyclerSE' {
          cpus = '16'
          memory = '30G'
          clusterOptions = '--time=16:00:00'
          time = { 2.hour * task.attempt*task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 2
        }

        withName: 'bwaIndex' {
          memory = '2G'
        }

        withName: 'samtools' {
          memory = '20G'
        }

        withName: 'pilon' {
          memory = '20G'
          time = { 8.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'pilonSE' {
          memory = '20G'
          time = { 8.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'pilon_remapping' {
          memory = '20G'
          time = { 8.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'pilon_remappingSE' {
          memory = '20G'
          time = { 8.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'prokka' {
          memory = '30G'
          cpus = 16
          clusterOptions = '--time=06:00:00'
          time = { 30.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'rMLST' {
          memory = '5G'
          time = { 15.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'metaphlan4' {
          memory = '40G'
          clusterOptions = '--time=06:00:00'
          time = { 15.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
          cpus = '16'
        }

        withName: 'metaphlan4SE' {
          memory = '40G'
          clusterOptions = '--time=06:00:00'
          time = { 15.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
          cpus = '16'
        }

        withName: 'abricate' {
          memory = '10G'
          time = { 10.min * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'busco' {
          memory = '30G'
          cpus = '16'
          clusterOptions = '--time=02:00:00'
          time = { 1.hour * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
          maxRetries = 3
        }

        withName: 'gtdbtk_classify_wf' {
          memory = '80G'
          time = {'30 min' * task.attempt }
          errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        }

        withName: 'summary_sample' {
          memory = '4G'
          cpus = '2'
        }

        withName: 'alignRemapping' {
          memory = '10G'
          cpus = '16'
        }

        withName: 'alignRemappingSE' {
          memory = '10G'
          cpus = '16'
        }

     }

   }

}
