process.shell = ['/bin/bash','-e']

// ======================================================
// ====== Importing Infrastructure Specific Profiles ====
// ======================================================

def configDir = "${projectDir}/conf/profiles"

// Verify the directory exists and list all `.config` files
// Import them with includeConfig
new File(configDir).eachFile { file ->
    if (file.name.endsWith('.config')) {
        includeConfig file.path
    }
}

//NOTE: For new infrastructure, create additional profiles in the `conf/profiles` directory, they'll automatically be imported

// ======================================================
// ===========      Basic Global Settings       =========
// ======================================================

singularity {
  cacheDir = params.singularity_container_cache
  enabled = true
  autoMounts = 'true'
  //runOptions = '-B /scratch -B /home -B /shares -B /data -B /tmp' // nextflow shold mount whatever it needs
}

manifest {
  name = "IMMENSE"
  version = '1.1.1'
}

// Loading default container images
includeConfig 'conf/container_images.config'

// Default process resources if nothing specific is defined
process {
  time = {'10.min' * task.attempt }
  cpus = '4'
  memory = '4G'
  //errorStrategy = 'ignore' // if errorStrategy is defined here it will overwrite what is written in profiles.
}

resume = true

// Creating an absolute path of the input directory for create_links.nf process 
// (needed in case the input is a relative path)
params.input_absolutePath = new File(params.input).absolutePath


// ======================================================
// ===========      Creating Reports            =========
// ======================================================

// outputs trace tsv file useful to see process timelines
trace {
        enabled         = true
}

// outputs html file to view pipeline process
report {
        enabled         = true
}

// outputs html timeline to explore duration of all steps
timeline {
        enabled         = true
}