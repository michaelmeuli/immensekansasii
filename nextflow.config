process.shell = ['/bin/bash','-e']

// ======================================================
// =========== INFRASTRUCTURE SPECIFIC SETTINGS =========
// ======================================================

// Load the infrastructure specific profiles (s3it and imm)

includeConfig 'conf/s3it.config'
includeConfig 'conf/imm.config'

// Create additional profiles for new infrastructure in the `conf` directory and add here
// includeConfig 'conf/yourInfrastructure.config'

// ======================================================
// ===========      BASIC GLOBAL SETTINGS       =========
// ======================================================

singularity {
  cacheDir = params.singularity_container_cache
  enabled = true
  autoMounts = 'true'
  //runOptions = '-B /scratch -B /home -B /shares -B /data -B /tmp' // nextflow shold mount whatever it needs
}

manifest {
  name = "IMMENSE on S3IT"
  version = '1.0.0'
}

process {
  time = {'10.min' * task.attempt }
  cpus = '4'
  memory = '4G'
  errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
  maxRetries    = 3


//TODO: Define container images for each process here

}

resume = true

// ======================================================
// ===========      Creating Reports            =========
// ======================================================

// outputs trace tsv file useful to see process timelines
trace {
        enabled         = true
}

// outputs html file to view pipeline process
report {
        enabled         = true
}

// outputs html timeline to explore duration of all steps
timeline {
        enabled         = true
}